# External reference repositories: never committed (clean-room and license boundary; see AGENTS.md / refs/REFS.md)
# Exception: the manifest itself is tracked so new machines can reconstruct refs/ via scripts/bootstrap-refs.sh
/refs/*
!/refs/REFS.md

# Local session notes (same convention as vectorcraft)
/plan/

# Test corpora fetched by `cargo xtask corpus` (never committed; same convention as vectorcraft)
/corpus/
# A craft-fonts checkout for CRAFT_FONTS_DIR (release builds check it out here)
/craft-fonts/
# Test logs
/log/

# Rust build artifacts
/target/
/fuzz/target/
/legacy/target/
**/*.rs.bk

# Distribution artifacts
/dist/

# Local Telegram bridge memory directory
/okf_memory/

# OS metadata
.DS_Store
