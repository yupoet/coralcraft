<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>ai.storyteller.coralcraft</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>CoralCraft</name>
  <summary>Vector illustration and multi-page layout studio</summary>
  <developer id="ai.storyteller">
    <name>CoralCraft Contributors</name>
  </developer>
  <description>
    <p>
      CoralCraft is a clean-room, open-source vector illustration and multi-page layout application.
      Create and edit Bézier curves, shapes, fills, gradients, live vector effects, and multi-page
      layouts, and exchange documents across .coralcraft, .cdr, .cmx, SVG 1.1, PDF 1.4, EPSF-3.0, and DXF.
    </p>
  </description>
  <launchable type="desktop-id">ai.storyteller.coralcraft.desktop</launchable>
  <icon type="stock">ai.storyteller.coralcraft</icon>
  <url type="homepage">https://github.com/yupoet/coralcraft</url>
  <url type="bugtracker">https://github.com/yupoet/coralcraft/issues</url>
  <url type="help">https://github.com/yupoet/coralcraft</url>
  <categories>
    <category>Graphics</category>
    <category>2DGraphics</category>
    <category>VectorGraphics</category>
  </categories>
  <keywords>
    <keyword>vector</keyword>
    <keyword>illustration</keyword>
    <keyword>svg</keyword>
    <keyword>pdf</keyword>
    <keyword>cdr</keyword>
    <keyword>drawing</keyword>
    <keyword>bezier</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#f06449</color>
    <color type="primary" scheme_preference="dark">#9e2a2b</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>coralcraft</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
